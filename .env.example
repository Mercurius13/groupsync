# PostgreSQL connection string (get from Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://user:password@host:5432/groupsync?sslmode=require"

# For Neon: use the pooled connection above, and the direct (non-pooled) below
DIRECT_URL="postgresql://user:password@host:5432/groupsync?sslmode=require"

# Change this to a long random secret in production
JWT_SECRET="change-me-to-a-long-random-secret"
